# Supabase public values (safe for browser)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only secret key (sb_secret_... preferred in 2026).
# NEVER prefix this with PUBLIC_ and never expose it to the browser/source control.
SUPABASE_SECRET_KEY=
# Legacy fallback only if your project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram Admin Assistant
TELEGRAM_BOT_TOKEN=
# One or more numeric chat IDs separated by commas. Example: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=
# 1-256 chars, only A-Z a-z 0-9 _ - . Use a random secret.
TELEGRAM_WEBHOOK_SECRET=
